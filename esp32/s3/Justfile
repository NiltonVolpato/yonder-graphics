# The Xtensa linker and tools from `espup`, which cargo needs on the PATH.
xtensa_gcc := "esp-15.2.0_20250920"
export PATH := home_directory() / ".rustup/toolchains/esp/xtensa-esp-elf" / xtensa_gcc / "xtensa-esp-elf/bin:" + env("PATH")

# Runs the on-device tests (the device must be connected).
test *args:
    cargo test --release {{args}}

# Runs the circle benchmark on the device.
bench:
    cargo test --release --test circles --test damage --test blend

# Flashes and runs the main binary.
run:
    cargo run --release

# Profiles the 390x390 ring on the device and symbolizes the hot spots.
profile:
    #!/usr/bin/env bash
    set -euo pipefail
    log=$(mktemp)
    cargo test --release --test profile 2>&1 | tee "$log"
    elf=$(sed -n 's|.*Running tests/profile.rs (\(.*\))$|\1|p' "$log" | tail -1)
    grep '\[PROFILE\] #' "$log" | python3 tools/symbolize_profile.py --by-function --elf "$elf"
    echo "Per-address detail: python3 tools/symbolize_profile.py --elf $elf < $log"
